# BITB - Bit Test B (Immediate: 0xC5)

---
name: immediate zero result
memory: C5 0F
setup: a=FF b=F0
# BITB does not modify B, A should be unaffected
expect: a=FF b=F0 Z=1 N=0 V=0
cycles: 2

---
name: direct
memory: D5 42
setup: b=FF
at 0042: 0F
expect: b=FF N=0 Z=0 V=0
cycles: 3

---
name: indexed
memory: E5 10
setup: b=FF x=1000
at 1010: 80
expect: b=FF N=1 Z=0 V=0
cycles: 4

---
name: extended
memory: F5 12 34
setup: b=FF
at 1234: 42
expect: b=FF N=0 Z=0 V=0
cycles: 4
