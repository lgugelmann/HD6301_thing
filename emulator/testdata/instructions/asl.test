# ASL - Arithmetic Shift Left Memory
# Indexed: 0x68, Extended: 0x78

---
name: indexed
memory: 68 10
setup: x=1000
at 1010: 01
expect: N=0 Z=0 V=0 C=0
expect_at 1010: 02
cycles: 6

---
name: extended into carry
memory: 78 12 34
at 1234: 80
# 0x80 << 1 = 0x00. C=1, N=0, V=0^1=1
expect: N=0 Z=1 V=1 C=1
expect_at 1234: 00
cycles: 6
